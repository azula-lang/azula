struct IntVec { data: str, len: int, cap: int, }
struct StrVec { data: str, len: int, cap: int, }

impl IntVec {
    func new(): IntVec {
        var cap: int = 8;
        var data: str = malloc(cap * 8);
        return IntVec { data: data, len: 0, cap: cap };
    }

    func push(self: &IntVec, val: int) {
        if self.len == self.cap {
            self.cap = self.cap * 2;
            self.data = realloc(self.data, self.cap * 8);
        }
        var slot: str = ptr_add(self.data, self.len * 8);
        ptr_write_int(slot, val);
        self.len = self.len + 1;
    }

    func get(self: IntVec, index: int): int {
        var slot: str = ptr_add(self.data, index * 8);
        return ptr_read_int(slot);
    }

    func set(self: &IntVec, index: int, val: int) {
        var slot: str = ptr_add(self.data, index * 8);
        ptr_write_int(slot, val);
    }

    func length(self: IntVec): int {
        return self.len;
    }

    func pop(self: &IntVec): int {
        self.len = self.len - 1;
        var slot: str = ptr_add(self.data, self.len * 8);
        return ptr_read_int(slot);
    }

    func peek(self: IntVec): int {
        var slot: str = ptr_add(self.data, (self.len - 1) * 8);
        return ptr_read_int(slot);
    }

    func free_data(self: IntVec) {
        free(self.data);
    }
}

impl StrVec {
    func new(): StrVec {
        var cap: int = 8;
        var data: str = malloc(cap * 8);
        return StrVec { data: data, len: 0, cap: cap };
    }

    func push(self: &StrVec, val: str) {
        if self.len == self.cap {
            self.cap = self.cap * 2;
            self.data = realloc(self.data, self.cap * 8);
        }
        var slot: str = ptr_add(self.data, self.len * 8);
        ptr_write_str(slot, val);
        self.len = self.len + 1;
    }

    func get(self: StrVec, index: int): str {
        var slot: str = ptr_add(self.data, index * 8);
        return ptr_read_str(slot);
    }

    func set(self: &StrVec, index: int, val: str) {
        var slot: str = ptr_add(self.data, index * 8);
        ptr_write_str(slot, val);
    }

    func length(self: StrVec): int {
        return self.len;
    }

    func pop(self: &StrVec): str {
        self.len = self.len - 1;
        var slot: str = ptr_add(self.data, self.len * 8);
        return ptr_read_str(slot);
    }

    func peek(self: StrVec): str {
        var slot: str = ptr_add(self.data, (self.len - 1) * 8);
        return ptr_read_str(slot);
    }

    func free_data(self: StrVec) {
        free(self.data);
    }
}

struct String {
    data: str,
    len: int,
}

impl String {
    func new(s: str): String {
        return String { data: s, len: strlen(s) };
    }

    func length(self: String): int {
        return self.len;
    }

    func equals(self: String, other: String): bool {
        return strcmp(self.data, other.data) == 0;
    }

    func charAt(self: String, index: int): int {
        return self.data[index];
    }

    func print(self: String) {
        printf("%s\n", self.data);
    }

    func substr(self: String, start: int, len: int): String {
        var buf = malloc(len + 1);
        memcpy(buf, ptr_add(self.data, start), len);
        return String { data: buf, len: len };
    }
}

func read_file(path: str): String {
    var f = fopen(path, "r");
    fseek(f, 0, 2);
    var size = ftell(f);
    fseek(f, 0, 0);
    var buf = malloc(size + 1);
    fread(buf, 1, size, f);
    fclose(f);
    return String { data: buf, len: size };
}
